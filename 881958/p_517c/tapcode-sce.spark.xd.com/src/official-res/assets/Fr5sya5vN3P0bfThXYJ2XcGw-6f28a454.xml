<?xml version="1.0"?>
<!--
    CelToon - binary cel shading.
    Input: BaseColor texture in the diffuse slot.
    Shadow side = baseColor * ShadowColor; lit side = baseColor * LightColor.
    Keep this technique material-only: no outline pass, post-process, or render path dependency.
-->
<technique vs="CelToon" ps="CelToon" vsdefines="NORMALMAP" psdefines="DIFFMAP NORMALMAP">
    <pass name="base"     psdefines="AMBIENT" />
    <pass name="litbase"  psdefines="AMBIENT" />
    <pass name="light"    depthtest="equal" depthwrite="false" blend="add" />
    <pass name="depth"    vs="Depth"  ps="Depth"  />
    <pass name="shadow"   vs="Shadow" ps="Shadow" />

    <parameter name="MatDiffColor"     value="1 1 1 1" />
    <parameter name="MatEmissiveColor" value="0 0 0" />
    <texture unit="normal" name="uuid://AokEaa4JVwNa02vgIeocpsW_" />

    <parameter name="ShadowColor"      value="0.35 0.38 0.45 1" />
    <parameter name="MidColor"         value="0.7 0.72 0.76 1" />
    <parameter name="LightThreshold"   value="0.5 0.06 0 0.5" />
    <parameter name="RimColor"         value="1 1 1 0.7" />
    <parameter name="RimParams"        value="0.3 0.04 0.85 1.2" />
</technique>
